# Origin of the Laravel backend. Server-only — never prefix with NEXT_PUBLIC_.
# Both /api/... and /storage/... are resolved against this value, so it must
# match the backend's APP_URL for image URLs to line up.
API_BASE_URL=http://127.0.0.1:8000

# The store's public address, for canonical URLs, the sitemap and structured
# data (e.g. https://raf.om). Optional: on Vercel the production domain is used,
# locally the request's own host.
SITE_URL=

# Firebase web push (FCM) for real-time notifications, same Firebase project as
# the backend and the vendor dashboard. Firebase console > Project settings >
# General > Your apps (web app config), and Cloud Messaging > Web Push
# certificates (VAPID key). These are public web keys, not secrets.
# Values: firebase+update/firebase-web-push-frontend.md (project raf1-1cb3d, the
# same Firebase project as the backend and the vendor dashboard).
# Leave them empty to turn browser push off; the inbox and bell still work.
# Restart `npm run dev` (or rebuild) after changing them.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
